{
	"version": 3,
	"routes": [
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/project/databased/?(?:/__data.json)?$",
			"dest": "/project/databased"
		},
		{
			"src": "^/project/fruit-ninja/?(?:/__data.json)?$",
			"dest": "/project/fruit-ninja"
		},
		{
			"src": "^/project/lockedin/?(?:/__data.json)?$",
			"dest": "/project/lockedin"
		},
		{
			"src": "^/project/osu-degree-audit/?(?:/__data.json)?$",
			"dest": "/project/osu-degree-audit"
		},
		{
			"src": "^/project/smarthub/?(?:/__data.json)?$",
			"dest": "/project/smarthub"
		},
		{
			"src": "^/project/triangle-pledge-hub/?(?:/__data.json)?$",
			"dest": "/project/triangle-pledge-hub"
		},
		{
			"src": "^/secret/?(?:/__data.json)?$",
			"dest": "/secret"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}